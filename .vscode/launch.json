{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run VS Code Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/src/visual-studio-code-extension"],
      "outFiles": ["${workspaceFolder}/src/visual-studio-code-extension/dist/**/*.js"],
      "preLaunchTask": "vscode-extension: watch"
    }
  ]
}

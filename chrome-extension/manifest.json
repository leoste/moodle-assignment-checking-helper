{
  "manifest_version": 3,
  "name": "Moodle Assignment Checking Helper",
  "description": "Speeds up checking assignments on Moodle by reducing clicks and typing.",
  "version": "1.0",
  "icons": {
    "16": "images/128.png",
    "128": "images/128.png"
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://moodle.taltech.ee/mod/assign/*action=grader*"],
      "js": ["src/content-scripts/assign-grader/index.ts"],
      "css": ["src/content-scripts/assign-grader/assign-grader.css"]
    },
    {
      "matches": ["https://moodle.taltech.ee/mod/quiz/review.php*"],
      "js": ["src/content-scripts/quiz-review/index.ts"],
      "css": ["src/content-scripts/quiz-review/quiz-review.css"]
    },
    {
      "matches": ["https://moodle.taltech.ee/mod/quiz/comment.php*"],
      "js": ["src/content-scripts/quiz-comment/index.ts"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["images/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "ws://127.0.0.1/*"
  ]
}

        <mxCell id="_9CwhJN1yaCqQ-_2WR2m-41" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;div&gt;&lt;b&gt;Listener&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- Listens to website changes and manages the lifecycle of presenter and manager. Creates then applies and connects them at the appropriate moment.&lt;/div&gt;&lt;div&gt;- Owns the presenter and the manager&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="160" x="50" y="80" as="geometry" />
        </mxCell>
        <mxCell id="_9CwhJN1yaCqQ-_2WR2m-46" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;div&gt;&lt;b&gt;Manager&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- Exposes functionality for interacting with the actual Moodle page&lt;/div&gt;&lt;div&gt;- Is owned by the listener&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="160" x="250" y="80" as="geometry" />
        </mxCell>
        <mxCell id="_9CwhJN1yaCqQ-_2WR2m-54" edge="1" parent="1" source="_9CwhJN1yaCqQ-_2WR2m-47" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;defaultLabelBackgroundColor=page;labelPadding=0 4;" target="_9CwhJN1yaCqQ-_2WR2m-48">

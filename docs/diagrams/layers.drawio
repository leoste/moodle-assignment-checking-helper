        <mxCell id="_9CwhJN1yaCqQ-_2WR2m-27" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;b&gt;Communication Layer&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Components communicate in two ways: messages and news, every major component does this. They are swapped between two groups.&lt;/div&gt;" vertex="1">

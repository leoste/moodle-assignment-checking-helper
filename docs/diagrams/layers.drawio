        <mxCell id="_9CwhJN1yaCqQ-_2WR2m-47" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;div&gt;&lt;b&gt;Presenter&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- Defines and implements business logic for interacting with Moodle and definitions&lt;/div&gt;&lt;div&gt;- Coordinates renderers to draw additional UI elements&lt;/div&gt;&lt;div&gt;- Owns the renderer&lt;/div&gt;&lt;div&gt;- Is owned by the manager&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="160" x="450" y="80" as="geometry" />
        </mxCell>
        <mxCell id="_9CwhJN1yaCqQ-_2WR2m-48" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;div&gt;&lt;b&gt;Renderer&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- Renders new UI components and manages their lifecycle&lt;/div&gt;&lt;div&gt;- Is owned by the presenter&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="160" x="650" y="80" as="geometry" />
        </mxCell>

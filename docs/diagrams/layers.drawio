        <mxCell id="_9CwhJN1yaCqQ-_2WR2m-37" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;div&gt;&lt;b&gt;Reporter&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- Listens to announcers and broadcasts news to other reporters or watchers&lt;/div&gt;" vertex="1">

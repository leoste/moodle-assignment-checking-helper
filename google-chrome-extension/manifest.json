{
  "manifest_version": 3,
  "name": "Moodle Assignment Checking Helper",
  "description": "Speeds up checking assignments on Moodle by reducing clicks and typing.",
  "version": "1.0",
  "icons": {
    "16": "images/128.png",
    "128": "images/128.png"
  },
  "background": {
    "service_worker": "scripts/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://moodle.taltech.ee/mod/assign/*action=grader*"],
      "js": [
        "scripts/content-scripts/js/component/base-component.js",
        "scripts/content-scripts/js/component/assign-grader-component.js",
        "scripts/content-scripts/js/helper/moodle/assign-grader-moodle-helper.js",
        "scripts/content-scripts/js/helper/moodle/base-moodle-helper.js",
        "scripts/content-scripts/js/helper/maths-helper.js",
        "scripts/content-scripts/js/helper/element-helper.js",
        "scripts/content-scripts/js/client/assignment-data-client.js",
        "scripts/content-scripts/js/client/common-data-client.js",
        "scripts/content-scripts/js/assign-grader.js"
      ],
      "css": [
        "scripts/content-scripts/css/assign-grader.css"
      ]      
    },
    {
      "matches": ["https://moodle.taltech.ee/mod/quiz/review.php*"],
      "js": [
        "scripts/content-scripts/js/helper/element-helper.js",
        "scripts/content-scripts/js/helper/moodle/base-moodle-helper.js",
        "scripts/content-scripts/js/helper/moodle/quiz-moodle-helper.js",
        "scripts/content-scripts/js/helper/moodle/quiz-review-moodle-helper.js",
        "scripts/content-scripts/js/client/quiz-data-client.js",
        "scripts/content-scripts/js/client/common-data-client.js",
        "scripts/content-scripts/js/quiz-review.js"
      ],
      "css": [
        "scripts/content-scripts/css/quiz-review.css"
      ]
    },
    {
      "matches": ["https://moodle.taltech.ee/mod/quiz/comment.php*"],
      "js": [
        "scripts/content-scripts/js/helper/element-helper.js",
        "scripts/content-scripts/js/helper/moodle/base-moodle-helper.js",
        "scripts/content-scripts/js/helper/moodle/quiz-moodle-helper.js",
        "scripts/content-scripts/js/helper/moodle/quiz-comment-moodle-helper.js",
        "scripts/content-scripts/js/client/quiz-data-client.js",
        "scripts/content-scripts/js/client/common-data-client.js",
        "scripts/content-scripts/js/quiz-comment.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["images/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "ws://127.0.0.1/*"
  ]
}

{
  "manifest_version": 3,
  "name": "Moodle Assignment Checking Helper",
  "description": "Speeds up checking assignments on Moodle by reducing clicks and typing.",
  "version": "1.0",
  "icons": {
    "16": "images/128.png",
    "128": "images/128.png"
  },
  "background": {
    "service_worker": "scripts/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://moodle.taltech.ee/mod/assign/*action=grader*"],
      "js": [
        "scripts/content-scripts/js/component/base-component.js",
        "scripts/content-scripts/js/component/grader-component.js",
        "scripts/content-scripts/js/helper/moodle-page-helper.js",
        "scripts/content-scripts/js/helper/element-helper.js",
        "scripts/content-scripts/js/client/data-client.js",
        "scripts/content-scripts/js/grader.js"
      ],
      "css": [
        "scripts/content-scripts/css/grader.css"
      ]
      
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["images/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "ws://127.0.0.1/*"
  ]
}

{
  // Editor-only config for code shared by both extensions. The real type checking of this code happens in every
  // component's own tsconfig (content script, popup, service worker, VS Code app, sidebar page), each with only what its
  // environment has. So shared code may contain page code (renderers, styles, DOM helpers), but a component without
  // the DOM (service worker, VS Code app) fails its check if it imports it. chrome.* and Node.js APIs don't belong here.
  // Keep "target" in sync with the extensions: esbuild reads the nearest tsconfig when
  // bundling these files, and target affects how class fields are compiled.
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "lib": ["ES2020", "DOM"],
    "types": []
  },
  "include": ["**/*"]
}

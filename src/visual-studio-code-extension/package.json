{
  "name": "moodle-assignment-checking-helper",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "1.0.4",
  "publisher": "karl-aleksander-leoste",
  "author": "Karl Aleksander Leoste",
  "icon": "images/icon.png",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      {
        "command": "moodle-helper.runPythonInTerminal",
        "title": "%command.runPythonInTerminal.title%"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "moodle-helper.runPythonInTerminal",
          "when": "resourceExtname == .py",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "moodle-helper.runPythonInTerminal",
          "when": "resourceExtname == .py",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "%extension.displayName%",
      "properties": {
        "moodle-helper.openSubDirectories": {
          "type": "boolean",
          "default": true,
          "description": "%setting.openSubDirectories.description%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "moodle-helper",
          "title": "%viewContainer.title%",
          "icon": "images/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "moodle-helper": [
        {
          "type": "webview",
          "id": "moodle-helper.sidebar",
          "name": "%view.sidebar.name%"
        }
      ]
    }
  },
  "main": "./dist/extension.js",
  "scripts": {
    "compile":          "node esbuild.js",
    "watch":            "node esbuild.js --watch",
    "typecheck":        "tsc --noEmit && tsc --noEmit -p webview",
    "vscode:prepublish": "node esbuild.js --production",
    "package":          "vsce package --no-dependencies --allow-missing-repository --skip-license",
    "lint":             "eslint background webview shared"
  },
  "devDependencies": {
    "@types/node": "22.x",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.18.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}

{
  // The sidebar's page runs in a browser context: the DOM is there, Node.js isn't.
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": [],
    "paths": {
      "@shared/*": ["../../../shared/*"]
    }
  },
  "include": ["./**/*"]
}

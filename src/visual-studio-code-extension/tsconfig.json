{
  // The extension's app runs in VS Code's background (Node.js) without the DOM. Shared code is checked only as far
  // as the app imports it: shared code may contain page code, and the app fails this check if it uses it.
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "lib": ["ES2020"],
    "types": ["node"],
    "paths": {
      "@shared/*": ["../shared/*"]
    }
  },
  "include": ["src/**/*"],
  // The sidebar's page runs in a browser context and is checked with its own tsconfig.
  "exclude": ["src/webview"]
}

{
  "name": "moodle-assignment-checking-helper",
  "displayName": "Moodle Assignment Checking Helper",
  "description": "Listens for signals from the Chrome extension and opens student files in VS Code.",
  "version": "1.0.1",
  "publisher": "karl-aleksander-leoste",
  "author": "Karl Aleksander Leoste",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      {
        "command": "moodle-helper.runPythonInTerminal",
        "title": "Run Python script in a new terminal"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "moodle-helper.runPythonInTerminal",
          "when": "resourceExtname == .py",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "moodle-helper.runPythonInTerminal",
          "when": "resourceExtname == .py",
          "group": "navigation"
        }
      ]
    }
  },
  "main": "./dist/extension.js",
  "scripts": {
    "compile":          "node esbuild.js",
    "watch":            "node esbuild.js --watch",
    "typecheck":        "tsc --noEmit",
    "vscode:prepublish": "node esbuild.js --production",
    "package":          "vsce package --no-dependencies --allow-missing-repository --skip-license",
    "lint":             "eslint src"
  },
  "devDependencies": {
    "@types/node": "22.x",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.18.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
